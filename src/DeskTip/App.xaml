<Application x:Class="DeskTip.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="{DynamicResource Palette.EDF0FC.Color}"/><SolidColorBrush x:Key="Muted" Color="{DynamicResource Palette.8694B1.Color}"/><SolidColorBrush x:Key="Accent" Color="{DynamicResource Palette.ADA0FF.Color}"/><SolidColorBrush x:Key="Surface" Color="{DynamicResource Palette.172033.Color}"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Foreground" Value="{DynamicResource Palette.EDF0FC}"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="{DynamicResource Palette.111827}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource Palette.202A40}"/><Setter Property="Foreground" Value="{DynamicResource Palette.CFD6EA}"/><Setter Property="BorderBrush" Value="{DynamicResource Palette.303B55}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="10"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Palette.9E91F2}"/><Setter TargetName="Body" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Palette.AEA1FF}"/><Setter Property="Foreground" Value="{DynamicResource Palette.17122F}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Ghost}"><Setter Property="Padding" Value="17,15"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Palette.E4E9F9}"/><Setter Property="CaretBrush" Value="{DynamicResource Palette.D0C8FF}"/><Setter Property="Background" Value="{DynamicResource Palette.10182A}"/><Setter Property="BorderBrush" Value="{DynamicResource Palette.303B53}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="{DynamicResource Palette.7261C5}"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Palette.A99CFF}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Palette.C8D2E8}"/><Setter Property="Margin" Value="0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Rail" Background="{DynamicResource Palette.35405A}" CornerRadius="11" Width="38" Height="22"><Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource Palette.ADB6CD}" HorizontalAlignment="Left" Margin="3"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="Background" Value="{DynamicResource Palette.8879E5}"/><Setter TargetName="Thumb" Property="Fill" Value="White"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Palette.DEE5F9}"/><Setter Property="Background" Value="{DynamicResource Palette.202A40}"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Palette.3E3B68}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Palette.39345E}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Palette.DDE5FA}"/><Setter Property="Background" Value="{DynamicResource Palette.10182A}"/><Setter Property="BorderBrush" Value="{DynamicResource Palette.303B53}"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,10,30,10" IsHitTestVisible="False"/><TextBlock Text="⌄" Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Palette.202A40}" BorderBrush="{DynamicResource Palette.4C486E}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Palette.151E31}"/><Setter Property="Foreground" Value="{DynamicResource Palette.D7E0F5}"/><Setter Property="RowBackground" Value="{DynamicResource Palette.151E31}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Palette.192337}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="34"/><Setter Property="CanUserAddRows" Value="False"/></Style>
