<Application x:Class="DeskTip.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#EDF0FC"/><SolidColorBrush x:Key="Muted" Color="#8694B1"/><SolidColorBrush x:Key="Accent" Color="#ADA0FF"/><SolidColorBrush x:Key="Surface" Color="#172033"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#111827"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#202A40"/><Setter Property="Foreground" Value="#CFD6EA"/><Setter Property="BorderBrush" Value="#303B55"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="10"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#9E91F2"/><Setter TargetName="Body" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#AEA1FF"/><Setter Property="Foreground" Value="#17122F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Ghost}"><Setter Property="Padding" Value="17,15"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#E4E9F9"/><Setter Property="CaretBrush" Value="#D0C8FF"/><Setter Property="Background" Value="#10182A"/><Setter Property="BorderBrush" Value="#303B53"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#7261C5"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#A99CFF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C8D2E8"/><Setter Property="Margin" Value="0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Rail" Background="#35405A" CornerRadius="11" Width="38" Height="22"><Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#ADB6CD" HorizontalAlignment="Left" Margin="3"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="Background" Value="#8879E5"/><Setter TargetName="Thumb" Property="Fill" Value="White"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DEE5F9"/><Setter Property="Background" Value="#202A40"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#3E3B68"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#39345E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#DDE5FA"/><Setter Property="Background" Value="#10182A"/><Setter Property="BorderBrush" Value="#303B53"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,10,30,10" IsHitTestVisible="False"/><TextBlock Text="⌄" Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#202A40" BorderBrush="#4C486E" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#151E31"/><Setter Property="Foreground" Value="#D7E0F5"/><Setter Property="RowBackground" Value="#151E31"/><Setter Property="AlternatingRowBackground" Value="#192337"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="34"/><Setter Property="CanUserAddRows" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#212D43"/><Setter Property="Foreground" Value="#96A7C8"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,3"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#373557"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><Grid><ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"/><TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#5E7295" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#172033"/><Setter Property="BorderBrush" Value="#263249"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="17"/><Setter Property="Padding" Value="23"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#9DAFCB"/><Setter Property="Margin" Value="0,15,0,8"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Opacity" Value="0.5"/></Style>
 </Application.Resources>
</Application>
