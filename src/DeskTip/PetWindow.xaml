<Window x:Class="DeskTip.PetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskTip 休息提醒" Width="370" SizeToContent="Height" MinHeight="390" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Image x:Name="PetImage" Width="190" Height="190" VerticalAlignment="Bottom" Margin="0,0,0,-14" Panel.ZIndex="1" MouseLeftButtonDown="Drag_MouseDown" RenderOptions.BitmapScalingMode="HighQuality"/>
  <Border Grid.Row="1" Background="#FAFCF7" BorderBrush="#D7E8D6" BorderThickness="1" CornerRadius="22" Padding="22,25,22,18"><StackPanel><Grid><TextBlock x:Name="LabelText" Text="小沐的温柔提醒" Foreground="#7C9879" FontSize="11"/><Button Content="✕" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Right" Click="Dismiss_Click" ToolTip="关闭这次提醒"/></Grid><TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,9" TextWrapping="Wrap"/><TextBlock x:Name="MessageText" Foreground="#758371" TextWrapping="Wrap" LineHeight="22"/><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="我去休息啦 ✓" Style="{StaticResource Primary}" Padding="10,11" Click="Dismiss_Click"/><Button x:Name="SnoozeButton" Grid.Column="2" Content="稍后 5 分钟" Padding="10,11" Click="Snooze_Click"/></Grid><TextBlock Text="45 秒后自动收起 · 不会打断你的输入" FontSize="9" Foreground="#95A28B" HorizontalAlignment="Center" Margin="0,11,0,0"/></StackPanel></Border>
 </Grid>
</Window>
