<Window x:Class="DeskTip.ReminderEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="DeskTip · 编辑提醒" Width="920" Height="790" MinWidth="820" MinHeight="680" WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#424361" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
  <Grid Background="#171D31" Margin="0" MouseLeftButtonDown="Title_MouseDown"><StackPanel Margin="27,14"><TextBlock x:Name="EditorTitle" Text="创建自己的提醒" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="OriginLabel" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button Content="✕" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Click="Cancel_Click"/></Grid>
  <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="27,10,27,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="23"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="提醒内容" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,2"/><TextBlock Text="名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameInput" MaxLength="40" TextChanged="Content_Changed"/><TextBlock Text="提醒文案" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MessageInput" MaxLength="240" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" TextChanged="Content_Changed"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="分类（可以自定义）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CategoryInput" MaxLength="12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="图标" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="IconInput"/></StackPanel></Grid>
    <TextBlock Text="时间规则" FontSize="17" FontWeight="SemiBold" Margin="0,27,0,2"/><TextBlock Text="提醒频率" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ModeInput" SelectionChanged="Mode_Changed"><ComboBoxItem Content="按间隔重复"/><ComboBoxItem Content="固定时刻重复"/><ComboBoxItem Content="指定日期一次"/></ComboBox>
    <StackPanel x:Name="IntervalPanel"><Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="每隔" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="IntervalInput"/><TextBlock Grid.Column="2" Text="分钟（1–480）" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid><Grid Margin="0,16,0,10"><TextBlock Text="生效时段 · HH:mm" Foreground="#9BAAC7" FontSize="12" VerticalAlignment="Center"/><Button Content="＋ 时段" HorizontalAlignment="Right" Padding="10,5" Click="AddPeriod_Click"/></Grid><DataGrid x:Name="PeriodsGrid" AutoGenerateColumns="False" RowHeaderWidth="0" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="开始" Binding="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Width="105"/><DataGridTextColumn Header="结束" Binding="{Binding End, UpdateSourceTrigger=PropertyChanged}" Width="105"/></DataGrid.Columns></DataGrid><Button Content="移除选中时段" HorizontalAlignment="Left" Padding="8,5" Margin="0,9,0,0" Style="{StaticResource Ghost}" Click="RemovePeriod_Click"/><TextBlock Text="每个时段开始后计算首次提醒；结束时不触发。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    <StackPanel x:Name="FixedPanel" Visibility="Collapsed"><TextBlock Text="提醒时刻 · HH:mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TimesInput"/><TextBlock Text="多个时刻用逗号分隔，例如 09:50, 18:20。" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
    <StackPanel x:Name="OncePanel" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="日期 · yyyy-MM-dd" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OnceDateInput"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="时刻 · HH:mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OnceTimeInput"/></StackPanel></Grid><TextBlock Text="按指定日期提醒一次，不受工作日历限制。" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
    <StackPanel x:Name="DaysPanel"><TextBlock Text="重复日期" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="DaysInput" SelectionChanged="Days_Changed"><ComboBoxItem Content="中国工作日（含节假日和调休）"/><ComboBoxItem Content="周一至周五"/><ComboBoxItem Content="每天"/><ComboBoxItem Content="自选星期"/></ComboBox><WrapPanel x:Name="WeekDaysPanel" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel>
    <TextBlock Text="提示方式" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,8"/><CheckBox x:Name="EnabledInput" Content="保存后开启这条提醒"/><CheckBox x:Name="CompanionInput" Content="显示桌面伴侣（关闭后仅显示提醒卡片）"/><CheckBox x:Name="QuietInput" Content="全屏时延迟这条提醒"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="「稍后提醒」延后" VerticalAlignment="Center"/><TextBox x:Name="SnoozeInput" Width="70" Margin="12,0"/><TextBlock Text="分钟（1–60）" Style="{StaticResource Caption}" VerticalAlignment="Center"/></StackPanel>
    <Expander Header="轮换文案（可选）" Foreground="#8FA1C1" Margin="0,22,0,0"><StackPanel Margin="0,12,0,0"><TextBox x:Name="RotationInput" Height="95" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/><TextBlock Text="每行一条，最多 20 条。填写后按顺序轮换，名称保持不变。留空则使用上方主文案。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Expander>
   </StackPanel>
   <StackPanel Grid.Column="2" Margin="0,14,0,0"><Border Style="{StaticResource Card}" Background="#21213B" Padding="19"><StackPanel><TextBlock Text="CONTENT PREVIEW" Foreground="#8D81B9" FontSize="9"/><Border x:Name="PreviewIconTile" Background="#35304E" CornerRadius="13" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,23,0,15"><Path x:Name="PreviewIcon" Stroke="#AFA2EF" StrokeThickness="1.7" Width="23" Height="25" Stretch="Uniform"/></Border><TextBlock x:Name="PreviewName" Text="自定义提醒" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="PreviewMessage" Text="你的提醒内容" Foreground="#9195B6" TextWrapping="Wrap" LineHeight="23" Margin="0,13,0,21"/><Button Content="预览桌面效果  ↗" Click="Preview_Click" Padding="10,9"/></StackPanel></Border><Border Background="#182136" CornerRadius="13" Padding="17" Margin="0,17,0,0"><StackPanel><TextBlock Text="独立规则，自由组合" Foreground="#BDCAEA" FontWeight="SemiBold"/><TextBlock Text="编辑这条提醒不会改变其他提醒的时间或稍后状态。相同时刻的提醒会合并展示，分别处理。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="22" Margin="0,11,0,0"/></StackPanel></Border></StackPanel>
  </Grid></ScrollViewer>
  <Grid Grid.Row="2" Background="#171D31" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Feedback" Foreground="#F3B0AB" TextWrapping="Wrap" VerticalAlignment="Center" Margin="27,0,17,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,23,0"><Button x:Name="DeleteButton" Content="删除" Style="{StaticResource Ghost}" Foreground="#BB8194" Click="Delete_Click" Margin="0,0,8,0"/><Button Content="取消" Click="Cancel_Click" Margin="0,0,10,0"/><Button Content="保存提醒 ✓" Style="{StaticResource Primary}" Click="Save_Click"/></StackPanel></Grid>
 </Grid></Border>
</Window>
