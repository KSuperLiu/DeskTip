<Window x:Class="DeskTip.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="DeskTip · 小憩" Width="1140" Height="790" MinWidth="1000" MinHeight="710" WindowStartupLocation="CenterScreen" Background="#F6F7F2" WindowStyle="None" ResizeMode="CanResizeWithGrip">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#D7E0D7" BorderThickness="1">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EEF2EA" BorderBrush="#E2E7DD" BorderThickness="0,0,1,0">
   <Grid Margin="20,30,20,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#235B47" CornerRadius="12" Width="40" Height="40"><TextBlock Text="◒" Foreground="#C8F3DB" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="DeskTip" FontSize="21" FontWeight="Bold"/><TextBlock Text="小 憩 · 桌 面 伴 侣" FontSize="10" Foreground="#768681"/></StackPanel></StackPanel><TextBlock Text="为专注留一点呼吸" Style="{StaticResource Caption}" Margin="4,22,0,30"/></StackPanel>
    <StackPanel Grid.Row="1"><Button x:Name="OverviewNav" Style="{StaticResource Nav}" Click="Overview_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="17" Margin="0,0,14,0"/><TextBlock Text="我的小憩"/></StackPanel></Button><Button x:Name="RulesNav" Style="{StaticResource Nav}" Click="Rules_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" FontSize="17" Margin="0,0,14,0"/><TextBlock Text="提醒规则"/></StackPanel></Button><Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="17" Margin="0,0,14,0"/><TextBlock Text="偏好设置"/></StackPanel></Button></StackPanel>
    <StackPanel Grid.Row="2"><Border Background="#E0E9DA" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="轻一点，刚刚好。" FontWeight="SemiBold"/><TextBlock Text="只在需要时，轻轻提醒你。" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="DESKTIP  /  V 1.0" FontSize="10" Foreground="#859181" Margin="8,22,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="Title_MouseDown" Background="Transparent" Margin="30,0,16,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#57A57C" Margin="0,0,9,0"/><TextBlock x:Name="StatusText" Text="正在陪伴" Style="{StaticResource Caption}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ClockText" Style="{StaticResource Caption}" Margin="0,0,25,0" VerticalAlignment="Center"/><Button Content="─" ToolTip="最小化" Padding="13,7" BorderThickness="0" Background="Transparent" Click="Minimize_Click"/><Button Content="□" ToolTip="最大化 / 还原" Padding="13,7" BorderThickness="0" Background="Transparent" Click="Maximize_Click"/><Button Content="✕" ToolTip="收起到托盘，继续提醒" Padding="13,7" BorderThickness="0" Background="Transparent" Click="Close_Click"/></StackPanel></Grid>
   <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="30,12,30,24">
    <StackPanel x:Name="OverviewPage">
     <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="专注，也别忘了自己。" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="一点水，一次起身，让工作保持舒服的节奏。" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E5EDDF" CornerRadius="20" Padding="14,8"><TextBlock Text="YOUR LITTLE PAUSE" Foreground="#567150" FontSize="10"/></Border></Grid>
     <Border CornerRadius="22" Background="#E4EEDF" Height="242" ClipToBounds="True">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="30,28,0,24"><TextBlock Text="MEET YOUR COMPANION" FontSize="10" Foreground="#658466"/><TextBlock Text="小沐 Mizu" FontSize="31" FontWeight="SemiBold" Margin="0,14,0,10"/><TextBlock Text="我会记得提醒你休息，&#x0a;你只管做好眼前的事。" Foreground="#5D7664" FontSize="14" LineHeight="25"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="看看提醒效果  ↗" Style="{StaticResource Primary}" Click="Preview_Click"/><Button x:Name="PauseButton" Content="暂停提醒" Background="Transparent" Margin="12,0,0,0" Click="Pause_Click"/></StackPanel></StackPanel>
       <Grid Grid.Column="1"><Ellipse Width="214" Height="214" Fill="#C9DCC8" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="174" Height="174" Stroke="#ABC5A9" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="HeroPet" Width="253" Height="253" Margin="0,-4,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><Border Background="#FFFFFF" CornerRadius="13" Padding="13,7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"><TextBlock Text="休息，是为了走得更远" FontSize="10" Foreground="#476552"/></Border><TextBlock Text="✧" FontSize="26" Foreground="#739F83" Margin="20,20,0,0" VerticalAlignment="Top"/></Grid>
      </Grid>
     </Border>
     <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="20,17"><StackPanel><TextBlock Text="下一次小憩" Style="{StaticResource Caption}"/><TextBlock x:Name="NextTimeText" Text="14:40" FontSize="31" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock x:Name="NextDetailText" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,17"><StackPanel><TextBlock Text="提醒节奏" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,5"><TextBlock x:Name="IntervalText" Text="50" FontSize="31" FontWeight="SemiBold"/><TextBlock Text=" 分钟" FontSize="12" Foreground="#768681" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel><TextBlock Text="每个时段独立计时" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,17"><StackPanel><TextBlock Text="工作日历" Style="{StaticResource Caption}"/><TextBlock x:Name="CalendarModeText" Text="中国工作日" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,9"/><TextBlock x:Name="CalendarDetailText" Text="节假日休息 · 调休日提醒" Style="{StaticResource Caption}"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22,18"><StackPanel><Grid><TextBlock Text="你的工作节奏" FontSize="16" FontWeight="SemiBold"/><Button Content="调整规则 →" HorizontalAlignment="Right" Padding="0" BorderThickness="0" Foreground="#357553" Click="Rules_Click"/></Grid><ItemsControl x:Name="PeriodsSummary" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="#66816B"/><Border Grid.Column="1" Background="#E5EEDD" Height="9" CornerRadius="4" Margin="15,0,24,0"/><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding Start}"/><TextBlock Text="  —  " Foreground="#94A190"/><TextBlock Text="{Binding End}"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="RulesPage" Visibility="Collapsed"><TextBlock Text="让提醒，适合你的节奏。" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="调整工作时间和休息内容。修改后点击「保存规则」生效。" Style="{StaticResource Caption}" Margin="0,10,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="工作时段" Style="{StaticResource SectionTitle}"/><Button Content="＋ 添加时段" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,7" Click="AddPeriod_Click"/></Grid><TextBlock Text="24 小时制 HH:mm · 时段开始后计算首次提醒 · 时段结束时停止" Style="{StaticResource Caption}" Margin="0,0,0,16"/><DataGrid x:Name="PeriodsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None" Background="White" BorderThickness="0" RowHeight="43" ColumnHeaderHeight="34" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="时段名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="开始时间" Binding="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Width="150"/><DataGridTextColumn Header="结束时间" Binding="{Binding End, UpdateSourceTrigger=PropertyChanged}" Width="150"/></DataGrid.Columns></DataGrid><Button Content="删除选中时段" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0" Click="RemovePeriod_Click"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><TextBlock Text="每隔" VerticalAlignment="Center"/><TextBox x:Name="IntervalInput" Width="80" Margin="14,0"/><TextBlock Text="分钟提醒一次（1–480）" VerticalAlignment="Center" Foreground="#768681"/></StackPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><Grid><TextBlock Text="休息提醒" Style="{StaticResource SectionTitle}"/><Button Content="＋ 添加提醒" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,7" Click="AddReminder_Click"/></Grid><TextBlock Text="已开启的提醒依次轮换，文案可以自由修改。" Style="{StaticResource Caption}" Margin="0,0,0,15"/><ItemsControl x:Name="RemindersEditor"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F5F7F2" CornerRadius="12" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Enabled}" ToolTip="开启这条提醒" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,0,0,8"/><TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Content="✕" ToolTip="删除提醒" Padding="6" Margin="10,0,0,0" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Tag="{Binding}" Click="RemoveReminder_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock Text="安静陪伴，刚刚好。" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="少一点打扰，多一点自在。" Style="{StaticResource Caption}" Margin="0,10,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="运行与提醒" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="EnabledInput" Content="开启工作时段提醒"/><CheckBox x:Name="StartupInput" Content="开机自动启动 · 静默运行到系统托盘"/><CheckBox x:Name="QuietInput" Content="全屏免打扰 · 游戏或演示时不弹出"/><TextBlock Text="提醒触发后，等待全屏结束（最多 10 分钟）；跨时段或休眠后不补发。" Style="{StaticResource Caption}" Margin="20,0,0,8" TextWrapping="Wrap"/><CheckBox x:Name="BeijingInput" Content="使用北京时间（UTC+8），不受系统时区影响"/><CheckBox x:Name="ChinaInput" Content="中国工作日 · 节假日关闭、周末调休开启"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="日历与配置" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="CalendarInfoText" TextWrapping="Wrap" LineHeight="23" Foreground="#768681"/><WrapPanel Margin="0,18,0,0"><Button Content="导入工作日历" Margin="0,0,10,10" Click="ImportCalendar_Click"/><Button Content="导出配置" Margin="0,0,10,10" Click="Export_Click"/><Button Content="导入配置" Margin="0,0,10,10" Click="Import_Click"/></WrapPanel><TextBlock Text="数据保存在本机。日历与规则可迁移，开机启动需在每台电脑单独设置。" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Background="#E9EFDF" CornerRadius="16" Padding="20" Margin="0,18,0,0"><StackPanel><TextBlock Text="轻量，是一种体贴。" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="原生 Windows 界面 · 15 秒低频检查 · 提醒时短暂出现&#x0a;后台无网页引擎，无联网请求，无持续动画。" Foreground="#6A7B63" Margin="0,10,0,0" LineHeight="23"/></StackPanel></Border>
    </StackPanel>
   </Grid></ScrollViewer>
   <Grid Grid.Row="2" Margin="30,8,30,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterHint" Text="小小的休息，也值得被认真对待。" FontSize="10" Foreground="#8E9988" VerticalAlignment="Center"/><TextBlock x:Name="RulesFeedback" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Margin="0,0,20,0"/><TextBlock x:Name="SettingsFeedback" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Margin="0,0,20,0"/><Button x:Name="FooterSave" Grid.Column="1" Visibility="Collapsed" Content="保存规则  ✓" Style="{StaticResource Primary}" Click="FooterSave_Click"/></Grid>
  </Grid>
 </Grid></Border>
</Window>
